From: Alessandro Astone <alessandro.astone@canonical.com>
Date: Fri, 25 Sep 2026 17:53:40 +0200
Subject: text: Protect against invalid offset

Avoid accessing invalid memory past the buffer size

Forwarded: https://gitlab.gnome.org/GNOME/gtk/-/merge_requests/10409
Bug-Ubuntu: https://launchpad.net/bugs/2167815
---
 gtk/gtktext.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/gtk/gtktext.c b/gtk/gtktext.c
index 37225c8..14e132c 100644
--- a/gtk/gtktext.c
+++ b/gtk/gtktext.c
@@ -7849,14 +7849,21 @@ gtk_text_accessible_text_get_extents (GtkAccessibleText *self,
                                       graphene_rect_t   *extents)
 {
   PangoLayout *layout = gtk_text_get_layout (GTK_TEXT (self));
+  GtkEntryBuffer *buffer;
   const char *text;
+  unsigned int length;
   int lx, ly;
   int range[2];
   cairo_region_t *range_clip;
   cairo_rectangle_int_t clip_rect;
 
+  buffer = get_buffer (GTK_TEXT (self));
+  length = gtk_entry_buffer_get_length (buffer);
+  if (start >= length || end >= length)
+    return FALSE;
+
   layout = gtk_text_get_layout (GTK_TEXT (self));
-  text = gtk_entry_buffer_get_text (get_buffer (GTK_TEXT (self)));
+  text = gtk_entry_buffer_get_text (buffer);
   get_layout_position (GTK_TEXT (self), &lx, &ly);
 
   range[0] = g_utf8_pointer_to_offset (text, text + start);
