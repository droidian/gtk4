From: Alessandro Astone <alessandro.astone@canonical.com>
Date: Fri, 25 Sep 2026 17:57:14 +0200
Subject: a11y: Protect against invalid offset

Forwarded: https://gitlab.gnome.org/GNOME/gtk/-/merge_requests/10409
Bug-Ubuntu: https://launchpad.net/bugs/2167815
---
 gtk/a11y/gtkatspitext.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/gtk/a11y/gtkatspitext.c b/gtk/a11y/gtkatspitext.c
index 5111181..7d66a63 100644
--- a/gtk/a11y/gtkatspitext.c
+++ b/gtk/a11y/gtkatspitext.c
@@ -432,6 +432,15 @@ accessible_text_handle_method (GDBusConnection       *connection,
 
       g_variant_get (parameters, "(iu)", &offset, &coords_type);
 
+      if (offset < 0)
+        {
+          g_dbus_method_invocation_return_error_literal (invocation,
+                                                         G_DBUS_ERROR,
+                                                         G_DBUS_ERROR_INVALID_ARGS,
+                                                         "Not a valid offset");
+          return;
+        }
+
       if (coords_type != ATSPI_COORD_TYPE_PARENT && coords_type != ATSPI_COORD_TYPE_WINDOW)
         {
           g_dbus_method_invocation_return_error_literal (invocation,
